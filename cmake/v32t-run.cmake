# v32t-run.cmake -- run one ACTION over a list of tools, each with its own build system.
#
# Script mode only:  cmake -DV32T_ROOT=... -DV32T_ACTION=build -DV32T_TOOLS=a,b -P v32t-run.cmake
# The top-level CMakeLists.txt builds these command lines for you.
#
# Inputs (-D):
#   V32T_ROOT            repository root                       (required)
#   V32T_ACTION          build debug clean distclean test install uninstall
#                        sysinstall sysuninstall flex doctor list
#   V32T_TOOLS           comma separated tool names
#   V32T_BACKEND         auto | make | cmake
#   V32T_BUILD_TYPE      CMake backend build type
#   V32T_BUILD_DIR       build trees for the CMake backend
#   V32T_PREFIX          system install prefix ('' = each tool's own default)
#   V32T_USER_PREFIX     prefix for the CMake backend's user-level install
#   V32T_JOBS            parallel jobs
#   V32T_FLEX            AUTO | OFF
#   V32T_MAKE_PROGRAM, V32T_MAKE_ARGS, V32T_CMAKE_ARGS, V32T_CMAKE_GENERATOR, V32T_SH
cmake_minimum_required(VERSION 3.16)

if(NOT V32T_ROOT OR NOT V32T_ACTION)
    message(FATAL_ERROR "v32t-run.cmake: V32T_ROOT and V32T_ACTION are required")
endif()

include("${V32T_ROOT}/cmake/V32ToolsManifest.cmake")
v32t_read_manifest("${V32T_ROOT}/tools.list")

if(NOT V32T_BACKEND)
    set(V32T_BACKEND auto)
endif()
if(NOT V32T_BUILD_TYPE)
    set(V32T_BUILD_TYPE Release)
endif()
if(NOT V32T_BUILD_DIR)
    set(V32T_BUILD_DIR "${V32T_ROOT}/build")
endif()
if(NOT V32T_USER_PREFIX)
    if(DEFINED ENV{HOME})
        set(V32T_USER_PREFIX "$ENV{HOME}")
    else()
        set(V32T_USER_PREFIX "$ENV{USERPROFILE}")
    endif()
endif()
if(NOT V32T_DEPS_PREFIX)
    set(V32T_DEPS_PREFIX "${V32T_BUILD_DIR}/deps")
endif()
string(REPLACE "," ";" V32T_TOOL_LIST "${V32T_TOOLS}")
separate_arguments(V32T_MAKE_ARGS_LIST  NATIVE_COMMAND "${V32T_MAKE_ARGS}")
separate_arguments(V32T_CMAKE_ARGS_LIST NATIVE_COMMAND "${V32T_CMAKE_ARGS}")

if(CMAKE_HOST_WIN32)
    set(_sep ";")
else()
    set(_sep ":")
endif()

# ---- helpers -------------------------------------------------------------------------
function(v32t_exec)
    cmake_parse_arguments(X "" "CWD" "CMD" ${ARGN})
    if(X_CWD)
        execute_process(COMMAND ${X_CMD} WORKING_DIRECTORY "${X_CWD}" RESULT_VARIABLE rc)
    else()
        execute_process(COMMAND ${X_CMD} RESULT_VARIABLE rc)
    endif()
    if(NOT rc EQUAL 0)
        string(REPLACE ";" " " _c "${X_CMD}")
        message(FATAL_ERROR "failed (${rc}): ${_c}")
    endif()
endfunction()

function(v32t_use_local_flex)
    if(EXISTS "${V32T_DEPS_PREFIX}/bin/flex" OR EXISTS "${V32T_DEPS_PREFIX}/bin/flex.exe")
        set(ENV{PATH} "${V32T_DEPS_PREFIX}/bin${_sep}$ENV{PATH}")
    endif()
endfunction()

function(v32t_build_flex)
    if(NOT V32T_SH)
        find_program(V32T_SH NAMES sh bash)
    endif()
    if(NOT V32T_SH)
        message(FATAL_ERROR "building flex needs a POSIX shell (sh); on Windows use an MSYS2 shell, "
                            "or install flex and put it on PATH")
    endif()
    set(ENV{V32T_DEPS_PREFIX} "${V32T_DEPS_PREFIX}")
    if(V32T_JOBS)
        set(ENV{V32T_JOBS} "${V32T_JOBS}")
    endif()
    v32t_exec(CMD "${V32T_SH}" "${V32T_ROOT}/scripts/v32t-flex.sh" ${ARGN})
endfunction()

function(v32t_have_cc out)
    find_program(_cc NAMES cc gcc clang cl)
    set(${out} ${_cc} PARENT_SCOPE)
    unset(_cc CACHE)
endfunction()

function(v32t_make_has_target makefile target out)
    file(STRINGS "${makefile}" _m REGEX "^${target}[ \t]*:([^=]|$)" LIMIT_COUNT 1)
    if(_m)
        set(${out} TRUE PARENT_SCOPE)
    else()
        set(${out} FALSE PARENT_SCOPE)
    endif()
endfunction()

function(v32t_need_flex)
    v32t_use_local_flex()
    find_program(_flex NAMES flex)
    if(NOT _flex)
        if(V32T_FLEX STREQUAL "OFF")
            unset(_flex CACHE)
            message(FATAL_ERROR "flex is required but not found (V32T_FLEX=OFF)")
        endif()
        message(STATUS "no flex on this host; building the vendored one")
        v32t_build_flex()
    endif()
    unset(_flex CACHE)
    v32t_use_local_flex()
endfunction()

# ---- one tool, one action --------------------------------------------------------------
function(v32t_run_tool tool action)
    set(src "${V32T_ROOT}/tools/${tool}")
    if(NOT EXISTS "${src}/Makefile" AND NOT EXISTS "${src}/CMakeLists.txt")
        message(FATAL_ERROR "tools/${tool} is empty -- fetch it first (git submodule update --init tools/${tool})")
    endif()

    # backend
    set(backend make)
    if(NOT V32T_BACKEND STREQUAL "make" AND EXISTS "${src}/CMakeLists.txt")
        set(backend cmake)
    elseif(V32T_BACKEND STREQUAL "cmake")
        message(STATUS "${tool} has no CMakeLists.txt; using its Makefile")
    endif()
    if(backend STREQUAL "make" AND NOT EXISTS "${src}/Makefile")
        set(backend cmake)
    endif()

    # host dependencies (build-ish actions only)
    if(action MATCHES "^(build|debug|test|install|sysinstall)$")
        set(missing "")
        foreach(d IN LISTS V32T_${tool}_HOSTDEPS)
            if(d STREQUAL "cc")
                v32t_have_cc(_cc)
                if(NOT _cc)
                    list(APPEND missing cc)
                endif()
            elseif(d STREQUAL "flex")
                v32t_need_flex()
            else()
                find_program(_p NAMES ${d})
                if(NOT _p)
                    list(APPEND missing ${d})
                endif()
                unset(_p CACHE)
            endif()
        endforeach()
        if(missing)
            string(REPLACE ";" " " missing "${missing}")
            message(FATAL_ERROR "${tool} needs: ${missing} (see docs/PLATFORMS.md)")
        endif()
    else()
        v32t_use_local_flex()
    endif()

    message(STATUS "==> ${tool}: ${action} [${backend}]")

    if(backend STREQUAL "make")
        v32t_run_make(${tool} ${action} "${src}")
    else()
        v32t_run_cmake(${tool} ${action} "${src}")
    endif()
endfunction()

function(v32t_run_make tool action src)
    if(NOT V32T_MAKE_PROGRAM)
        find_program(V32T_MAKE_PROGRAM NAMES gmake make mingw32-make)
    endif()
    if(NOT V32T_MAKE_PROGRAM)
        message(FATAL_ERROR "${tool}: make not found (needs GNU make; on Windows use MSYS2/MinGW)")
    endif()

    # refuse staged installs that the Makefile would silently ignore
    if(action MATCHES "^sys(un)?install$" AND NOT "$ENV{V32T_FORCE}" STREQUAL "1")
        file(READ "${src}/Makefile" _mk)
        foreach(v DESTDIR PREFIX)
            set(_val "$ENV{${v}}")
            if(v STREQUAL "PREFIX")
                set(_val "${V32T_PREFIX}")
            endif()
            if(_val)
                string(FIND "${_mk}" "${v}" _pos)
                if(_pos EQUAL -1)
                    message(FATAL_ERROR "${tool}: its Makefile ignores ${v} and would install to its fixed location. "
                                        "Use -DV32T_BACKEND=cmake for this tool, or set V32T_FORCE=1.")
                endif()
            endif()
        endforeach()
    endif()

    set(target "")
    if(action STREQUAL "build")
        set(target all)
    elseif(action STREQUAL "distclean")
        v32t_make_has_target("${src}/Makefile" distclean _h)
        set(target clean)
        if(_h)
            set(target distclean)
        endif()
    elseif(action STREQUAL "test")
        v32t_make_has_target("${src}/Makefile" test _h)
        if(_h)
            set(target test)
        else()
            v32t_make_has_target("${src}/Makefile" check _h2)
            if(_h2)
                set(target check)
            endif()
        endif()
    else()
        v32t_make_has_target("${src}/Makefile" ${action} _h)
        if(_h)
            set(target ${action})
        endif()
    endif()
    if(NOT target)
        message(STATUS "    (no '${action}' target)")
        return()
    endif()

    if(action MATCHES "^sys(un)?install$" AND V32T_PREFIX)
        set(ENV{PREFIX} "${V32T_PREFIX}")
    endif()
    set(jobs "")
    if(V32T_JOBS)
        set(jobs "-j${V32T_JOBS}")
    endif()
    v32t_exec(CMD "${V32T_MAKE_PROGRAM}" -C "${src}" ${jobs} ${V32T_MAKE_ARGS_LIST} ${target})
endfunction()

function(v32t_run_cmake tool action src)
    set(bld "${V32T_BUILD_DIR}/cmake/${tool}")
    set(btype "${V32T_BUILD_TYPE}")
    if(action STREQUAL "debug")
        set(btype Debug)
    endif()
    set(gen "")
    if(V32T_CMAKE_GENERATOR)
        set(gen -G "${V32T_CMAKE_GENERATOR}")
    endif()
    set(par "")
    if(V32T_JOBS)
        set(par --parallel ${V32T_JOBS})
    endif()

    # build tree up to date? (configure once; --build re-runs configure when needed)
    macro(_build)
        if(NOT EXISTS "${bld}/CMakeCache.txt")
            set(_pfx "")
            if(V32T_PREFIX)
                set(_pfx "-DCMAKE_INSTALL_PREFIX=${V32T_PREFIX}")
            endif()
            v32t_exec(CMD "${CMAKE_COMMAND}" -S "${src}" -B "${bld}" ${gen}
                          "-DCMAKE_BUILD_TYPE=${btype}" ${_pfx} ${V32T_CMAKE_ARGS_LIST})
        endif()
        v32t_exec(CMD "${CMAKE_COMMAND}" --build "${bld}" --config "${btype}" ${par})
    endmacro()

    if(action STREQUAL "build" OR action STREQUAL "debug")
        _build()
    elseif(action STREQUAL "clean")
        if(EXISTS "${bld}/CMakeCache.txt")
            v32t_exec(CMD "${CMAKE_COMMAND}" --build "${bld}" --target clean)
        else()
            message(STATUS "    (nothing built)")
        endif()
    elseif(action STREQUAL "distclean")
        file(REMOVE_RECURSE "${bld}")
    elseif(action STREQUAL "test")
        _build()
        get_filename_component(_d "${CMAKE_COMMAND}" DIRECTORY)
        find_program(_ctest NAMES ctest HINTS "${_d}")
        v32t_exec(CWD "${bld}" CMD "${_ctest}" --output-on-failure -C "${btype}")
    elseif(action STREQUAL "install")
        _build()
        v32t_exec(CMD "${CMAKE_COMMAND}" --install "${bld}" --config "${btype}" --prefix "${V32T_USER_PREFIX}")
    elseif(action STREQUAL "sysinstall")
        _build()
        set(_p "")
        if(V32T_PREFIX)
            set(_p --prefix "${V32T_PREFIX}")
        endif()
        v32t_exec(CMD "${CMAKE_COMMAND}" --install "${bld}" --config "${btype}" ${_p})
    else() # uninstall, sysuninstall
        if(NOT EXISTS "${bld}/CMakeCache.txt")
            message(FATAL_ERROR "${tool}: no build tree at ${bld}; an uninstall replays the install manifest of the last install from that tree")
        endif()
        v32t_exec(CMD "${CMAKE_COMMAND}" --build "${bld}" --config "${btype}" --target uninstall)
    endif()
endfunction()

# ---- doctor / list -----------------------------------------------------------------------
function(v32t_doctor)
    message(STATUS "Host programs:")
    foreach(p cc make gmake cmake git bison flex m4 python3 unzip)
        if(p STREQUAL "cc")
            v32t_have_cc(_x)
        else()
            find_program(_x NAMES ${p})
        endif()
        if(_x)
            message(STATUS "  ${p}: ${_x}")
        else()
            message(STATUS "  ${p}: --")
        endif()
        unset(_x CACHE)
        unset(_x)
    endforeach()
    message(STATUS "Tools:")
    foreach(t IN LISTS V32T_ALL_TOOLS)
        set(bs "")
        if(EXISTS "${V32T_ROOT}/tools/${t}/Makefile")
            list(APPEND bs make)
        endif()
        if(EXISTS "${V32T_ROOT}/tools/${t}/CMakeLists.txt")
            list(APPEND bs cmake)
        endif()
        set(miss "")
        foreach(d IN LISTS V32T_${t}_HOSTDEPS)
            if(d STREQUAL "cc")
                v32t_have_cc(_x)
            else()
                find_program(_x NAMES ${d})
            endif()
            if(NOT _x)
                list(APPEND miss ${d})
            endif()
            unset(_x CACHE)
            unset(_x)
        endforeach()
        if(bs)
            set(state "present [${bs}]")
        else()
            set(state "absent")
        endif()
        message(STATUS "  ${t}: ${state}  missing: ${miss}")
    endforeach()
endfunction()

function(v32t_list)
    foreach(t IN LISTS V32T_ALL_TOOLS)
        set(st absent)
        if(EXISTS "${V32T_ROOT}/tools/${t}/Makefile" OR EXISTS "${V32T_ROOT}/tools/${t}/CMakeLists.txt")
            set(st present)
        endif()
        message(STATUS "${t} (${st}): ${V32T_${t}_DESC}")
    endforeach()
endfunction()

# ---- dispatch ----------------------------------------------------------------------------
if(V32T_ACTION STREQUAL "doctor")
    v32t_doctor()
elseif(V32T_ACTION STREQUAL "list")
    v32t_list()
elseif(V32T_ACTION STREQUAL "flex")
    v32t_build_flex()
elseif(V32T_ACTION MATCHES "^(build|debug|clean|distclean|test|install|uninstall|sysinstall|sysuninstall)$")
    foreach(t IN LISTS V32T_TOOL_LIST)
        v32t_run_tool(${t} ${V32T_ACTION})
    endforeach()
else()
    message(FATAL_ERROR "unknown V32T_ACTION '${V32T_ACTION}'")
endif()
