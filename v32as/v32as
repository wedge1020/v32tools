########################################################################################
##
## getregnum(): obtain numeric value of register
##
function getregnum()
{
    REG="${1}"
    case "${REG}" in
        "CR")
            VAL="1011"
            ;;
        "SR")
            VAL="1100"
            ;;
        "DR")
            VAL="1101"
            ;;
        "BP")
            VAL="1110"
            ;;
        "SP")
            VAL="1111"
            ;;
        "IP")
            VAL="none"
            ;;
        "IR")
            VAL="none"
            ;;
        "IV")
            VAL="none"
            ;;
        *)
            VAL=$(echo "${REG}" | tr -d 'A-Za-z:')
            VAL=$(echo "obase=2; ${VAL}" | bc -q)
            VAL=$(printf "%.4d" "${VAL}")
            ;;
    esac
    echo "${VAL}"
}

########################################################################################
##
## getportnum(): obtain numeric value of IOPort
