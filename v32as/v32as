########################################################################################
##
## getregnum(): obtain numeric value of register
##
function getregnum()
{
    REG="${1}"
    VAL=
    case "${REG}" in
        "CR")
            VAL="1011"
            ;;
        "SR")
            VAL="1100"
            ;;
        "DR")
            VAL="1101"
            ;;
        "BP")
            VAL="1110"
            ;;
        "SP")
            VAL="1111"
            ;;
        "IP")
            VAL="none"
            ;;
        "IR")
            VAL="none"
            ;;
        "IV")
            VAL="none"
            ;;
        *)
            VAL=$(echo "${REG}" | tr -d 'A-Za-z:')
            VAL=$(echo "obase=2; ${VAL}" | bc -q)
            VAL=$(printf "%.4d" "${VAL}")
            ;;
    esac
    echo "${VAL}"
}

########################################################################################
##
## getportnum(): obtain numeric value of IOPort
##
function getportnum()
{
    portname="${1}"

    IOP="${IOPORT[${portname}]}"

    echo "${IOP}"
}

########################################################################################
##
## getportcmdnum(): obtain numeric value of IOPort Command
##
function getportcmdnum()
{
    cmdname="${1}"

    CMD="${IOPORTCMD[${cmdname}]}"

    echo "${CMD}"
}

########################################################################################
##
## parse_reg(): function to parse and return the register component from  the
##              provided token. Will ensure the returned value is using upper
##              case letters. Supports all the aliased registers.
##
function parse_reg()
{
    token="${1}"
    the_reg=$(echo "${token}" | egrep -o "^${REGISTER}$")
    the_reg="${the_reg^^}"
    echo "${the_reg}"
}

########################################################################################
##
## parse_imm(): function to parse and convert immediate value to standard hex
##              representation, leading '0x', and 8 total digits. It converts
##              a number of recognized formats:
##
##              0bXXXX - binary value (1-32 bits)
##              0XXXX  - octal value
##              XXXX   - decimal value
##              #XXXX  - decimal value
##              0xXXXX - standard hexadecimal representation (the target)
##              XXXXH  - alternate hexadecimal representation
##              X.XXXX - floating point value
##
function parse_imm()
{
    ####################################################################################
    ##
    ## declare and initialize variables
    ##
    token="${1}"
    label="${2}"
    d_imm=
    t_imm=
    l_imm=

    ####################################################################################
    ##
    ## check each potential category to validate data as immediate
    ##
    for attr in bin oct dec1 dec2 hex1 hex2 float ${label}; do

        case "${attr}" in
            "bin")
                d_imm=$(echo "${token}" | egrep -o "^${BIN}$")
                d_imm="${d_imm//0[bB]/}"
                t_imm=$(echo "${token}" | egrep -o "^${BIN}$" | wc -l)
                d_imm=$(echo "obase=16; ibase=2; ${d_imm}"  | bc)
                ;;

            "oct")
                d_imm=$(echo "${token}" | egrep -o "^${OCT}$")
                t_imm=$(echo "${token}" | egrep -o "^${OCT}$" | wc -l)
                d_imm=$(echo "obase=16; ibase=8; ${d_imm}"  | bc)
                ;;

            "dec1")
                d_imm=$(echo "${token}" | egrep -o "^${DEC1}$")
                d_imm="${d_imm//+/}"
                d_chk=$(echo "${d_imm}" | egrep -qio '^-' && echo "true")
                if [ ! -z "${d_chk}" ]; then
                    d_imm=$(echo "${token}")
                    d_imm="${d_imm//-/}"
                    d_imm=$(echo "obase=2; (2^32)-${d_imm}"  | bc)
                    d_imm=$(echo "ibase=2; ${d_imm}"         | bc)
                fi
                t_imm=$(echo "${token}" | egrep -o "^${DEC1}$" | wc -l)
                d_imm=$(echo "obase=16; ibase=10; ${d_imm}"  | bc)
                ;;

            "dec2")
                d_imm=$(echo "${token}" | egrep -o "^${DEC2}$")
                d_imm="${d_imm//[#+]/}"
                d_chk=$(echo "${d_imm}" | egrep -qio '^-' && echo "true")
                if [ ! -z "${d_chk}" ]; then
                    d_imm=$(echo "${d_imm}")
                    d_imm="${d_imm//-/}"
                    d_imm=$(echo "obase=2; (2^32)-${d_imm}"    | bc)
                    d_imm=$(echo "ibase=2; ${d_imm}"           | bc)
                fi
                t_imm=$(echo "${token}" | egrep -o "^${DEC2}$" | wc -l)
                d_imm=$(echo "obase=16; ibase=10; ${d_imm}"    | bc)
                ;;

            "hex1")
                d_imm=$(echo "${token}" | egrep -o "^${HEX1}$")
                d_imm="${d_imm//0[Xx]/}"
                t_imm=$(echo "${token}" | egrep -o "^${HEX1}$" | wc -l)
                ;;

            "hex2")
                d_imm=$(echo "${token}" | egrep -o "^${HEX2}$")
                d_imm="${d_imm//[Hh]/}"
                t_imm=$(echo "${token}" | egrep -o "^${HEX2}$" | wc -l)
                ;;

            "float")
                d_imm=$(echo "${token}" | egrep -o "^${FLOAT}$")
                t_imm=$(echo "${token}" | egrep -o "^${FLOAT}$" | wc -l)
                if [ "${t_imm}" -gt 0 ]; then
                    d_imm=$(${FLOATIFY} "${token}")
                    d_imm="${d_imm//0x/}"
                fi
                ;;

            "label")
                d_imm=$(echo "${token}" | egrep -o "^${LABEL}$")
                t_imm=$(echo "${token}" | egrep -o "^${LABEL}$" | wc -l)

                ########################################################################
                ##
                ## if alabel, check if there is already an entry within LABELSYM;
                ## if not, append it
                ##
                if [ ! -z "${d_imm}" ]; then
                    l_imm="true"
                    lchk=$(cat ${LABELSYM} | egrep -o "^${d_imm}:" | wc -l)
                    if [ "${lchk}" -eq 1 ]; then
                        laddr=$(cat ${LABELSYM} | egrep "^${d_imm}:" | cut -d':' -f2)
                        d_imm="${laddr}"
                    fi
                fi
                ;;
        esac

        [ "${t_imm}" -gt 0 ] && break
    done

    ####################################################################################
    ##
    ## if resulting immediate data (d_imm) is a number, it will be in hex,
    ## so ensure it is formatted properly. But do not do so if a label.
    ##
    if [ ! -z "${d_imm}" ] && [ -z "${l_imm}" ]; then
        d_imm="0x${d_imm}"
        d_imm=$(printf "0x%.8X" "${d_imm}")
    fi
    echo "${d_imm}"
}

function parse_operator()
{
    token="${1}"
    for attr in bin oct dec1 dec2 hex1 hex2; do
        p_data=$(echo "${token}"  | egrep -o "${ITYPE[${attr}]}")
        p_type=$(echo "${token}"  | egrep -o "${ITYPE[${attr}]}" | wc -l)
        if [ "${p_type}" -eq 1 ]; then
            case "${attr}" in
                "+")
                    ;;
                "-")
                    ;;
            esac
            p_data=$(echo "${p_data}"   | tr    'X' 'x' | cut -d'x' -f2)
            p_data=$(printf "0x%8s" "${p_data}" | tr ' ' '0')
            break
        fi
    done
    echo "${p_data}"
}

########################################################################################
##
## parse_iop(): function to parse and return the hex address of the  provided
##              V32 IOPort
##
function parse_iop()
{
    portname="${1}"
    portnum=
    portchk=$(echo "${portname}" | egrep -o "^${IOPORTSYM}$")
    numchk=

    [ ! -z "${portchk}" ] && portnum="${IOPORT[${portname}]}"
    [   -z "${portchk}" ] && numchk=$(echo "${portname}" | egrep -o "^${IOPORTHEX}$")
    [ ! -z "${numchk}"  ] && portnum="${portname}"
    #[   -z "${portnum}" ] && portnum="${IOPORTCMD[${portname}]}"
    #[   -z "${portnum}" ] && portnum=$(echo "${portname}" | egrep -o "${IOPORTCMDHEX}$")

    debug "portname:  ${portname}" 1>&2
    debug "portnum:   ${portnum}"  1>&2

    echo "${portnum}"
}

########################################################################################
##
## parse_param(): general operand processing; figure out what it is and obtain
##                useful, pertinent data that is returned
##
function parse_param()
{
    operand="${1}"
    categories="${2}"
    flags="${3}"
    deref=$(echo "${flags}" | egrep -qio '\<deref\>' && echo "true")
    label=$(echo "${flags}" | egrep -io  '\<label\>')
    pFLG=0
    pREF=

   # debug    "operand:    ${operand}"    1>&2
   # debug    "categories: ${categories}" 1>&2
   # debug    "flags:      ${flags}"      1>&2

    ####################################################################################
    ##
    ## check for a dereferenced parameter, mark it and then update the
    ## parameter string for further processing
    ##
    if [ ! -z "${deref}" ] && [ "${deref}" = "true" ]; then
        chk=$(echo "${operand}" | egrep -o "^${DEREF}$"   | wc -l)
        if [ "${chk}" -eq 1 ]; then
            pREF="true"
            operand=$(echo "${operand}" | tr -d '[' | tr -d ']')
        fi
    fi

    ####################################################################################
    ##
    ## process for each indicated category, based on the potential set
    ## of scenarios per given instruction
    ##
    for item in ${categories}; do

        case ${item} in

            ############################################################################
            ##
            ## check for immediate parameter
            ##
            "immediate")
                pIMM=$(parse_imm "${operand}" ${label})
                [ ! -z "${pIMM}" ] && pFLG=1 && break
                ;;

            ############################################################################
            ##
            ## check for register parameter
            ##
            "register")
                pREG=$(parse_reg "${operand}")
                [ ! -z "${pREG}" ] && break
                ;;

            ############################################################################
            ##
            ## check for an indexed parameter, split it and identify each of
            ## the components
            ##
            "indexed")
                [ -z "${pREF}"  ] && do_error ${offset} ${line_input} "invalid indexing use"
                chk=$(echo       "${operand}" | egrep -o "^${INDEXED}$" | wc -l)
                if [ "${chk}" -eq 1 ]; then
                    delim=$(echo "${operand}" | grep -o '[+]')
                    [ -z "${delim}" ] && delim=$(echo "${operand}" | grep -o '[-]')
                    left=$(echo  "${operand}" | cut -d"${delim}" -f1)
                    right=$(echo "${operand}" | cut -d"${delim}" -f2)
                    pREG=$(parse_reg "${left}")
                    pIMM=$(parse_imm "${right}")
                    pFLG=1
                    [ "${delim}" = "-" ] && pIMM=$(${NEGATE} ${pIMM})
                    break
                fi
                ;;

            ############################################################################
            ##
            ## check for IOPort parameter (symbolic or hex numeric)
            ##
            "ioport")
                pIOP=$(parse_iop "${operand}")
                ;;
        esac
    done

    ################################################################################
    ##
    ## For register transactions, also determine its numeric value (SRCVAL)
    ##
    if [ ! -z "${pREG}" ]; then
        pVAL=$(getregnum "${pREG}")
    fi

    ################################################################################
    ##
    ## Display the results
    ##
    echo     "${pREG}:${pVAL}:${pIMM}:${pREF}:${pFLG}:${pIOP}:${label}"
}

function do_error()
{
    offset="${1}"
    offset=$(echo "${offset}" | egrep -io "^${HEX1}$")
    [ ! -z "${offset}" ] && shift 1

    opcode=$(echo      "${1}" | cut -d' ' -f1)
    dst_operand=$(echo "${1}" | cut -d' ' -f2)
    src_operand=$(echo "${1}" | cut -d' ' -f3)
    error_type="${2}"

    [   -z "${error_type}" ] && error_type="invalid use"

    [   -z "${offset}" ] && echo -n "[ERROR] "
    [ ! -z "${offset}" ] && echo -n "[ERROR@${offset}] "

    if [   ! -z "${src_operand}" ]; then
        echo "${error_type} on \"${opcode} ${dst_operand}, ${src_operand}\""
    elif [ ! -z "${dst_operand}" ]; then
        echo "${error_type} on \"${opcode} ${dst_operand}\""
    else
        echo "${error_type} on \"${opcode}\""
    fi
    
    exit 1
}

########################################################################################
##
## debug function (displays information to STDERR, when enabled)
##
function debug()
{
    ####################################################################################
    ##
    ## if verbosity is not enabled, bail out
    ##
    [ "${VERBOSE}" = "false" ] && return

    ####################################################################################
    ##
    ## declare and initialize variables
    ##
    NONEWLINE=
    NO_HEADER=

    ####################################################################################
    ##
    ## grab the location from the BASH function call array
    ##
    place="${FUNCNAME[1]}"
    [ "${place}" = "main" ] && place=$(basename ${0})

    ####################################################################################
    ##
    ## allow for turning off auto-newline
    ##
    [ "${1}" = "-n"       ] && NONEWLINE="true" && shift 1

    ####################################################################################
    ##
    ## allow for turning off auto-newline
    ##
    [ "${1}" = "-H"       ] && NO_HEADER="true" && shift 1

    ####################################################################################
    ##
    ## the content to actually be displayed
    ##
    message="${1}"

    ####################################################################################
    ##
    ## display the header, if enabled
    ##
    [   -z "${NO_HEADER}" ] && echo -n "[${place}] " 1>&2

    ####################################################################################
    ##
    ## deliver the message, based on settings
    ##
    [ ! -z "${NONEWLINE}" ] && echo -n "${message}"  1>&2
    [   -z "${NONEWLINE}" ] && echo    "${message}"  1>&2
}

