#!/usr/bin/env bash
### 
###             v32as - Vircon32 assembler written in BASH, powered by
###                     Regular Expressions
### 
###              usage: v32as [OPTION..] [ASMFILE..]
### 
###            option - description
### =================   ===================================================
###              bios   assemble for BIOS
###              cart   assemble for CART
###              none   standalone instruction assembly (default)
###              step   pause after each instruction
###            binary   output resulting binary machine code to STDOUT
###           verbose   increase verbosity
###              help   display usage information and exit
### 
### NOTE: It is meant for v32pp, the Vircon32 Assembly Pre-Processor, to be
### run prior to passing the code through this assembler. Furthermore,  for
### the production of an actual VBIN file, a further tool is required. This
### assembler will ONLY convert to machine code, and nothing more.
### 
########################################################################################

########################################################################################
##
## Process command-line arguments
##
DO_HELP=$(echo "${*}" | egrep -qio '\<help\>' && echo "true" || echo "false")
VERBOSE=$(echo "${*}" | egrep -qio '\<verbos' && echo "true" || echo "false")
DO_BIOS=$(echo "${*}" | egrep -qio '\<bios\>' && echo "true" || echo "false")
DO_CART=$(echo "${*}" | egrep -qio '\<cart\>' && echo "true" || echo "false")
BINARY=$(echo  "${*}" | egrep -qio '\<binary' && echo "true" || echo "false")
DO_STEP=$(echo "${*}" | egrep -qio '\<step\>' && echo "true" || echo "false")
REGEX='\<(bios|cart|none|binary|step|verbose|help)\>'
ARGS=$(echo    "${*}"    | tr ' ' '\n' | egrep -v "${REGEX}" | tr '\n' ' ')
ARGS=$(echo    "${ARGS}" | grep -v '^[ ]*$')

########################################################################################
##
## Display usage information if requested (and exit)
##
[ "${DO_HELP}" = "true" ] && cat ${0} | grep '^### ' | tr -d '#' && exit 0

########################################################################################
##
## Declare and initialize variables
##
BINCODE=$(whereis -b bincode | cut -d' ' -f2)
FLOATIFY="${BINCODE} -t -f "
NEGATE="${BINCODE} -t -n -w "
TMP=$(mktemp -p /tmp v32as.XXXX)
BINFILE="${TMP}.bin"
LABELSYM="${TMP}.SYM"

########################################################################################
##
## Establish RegEx patterns for tokens
##
OPCODE='^(IN|JT|JF|OR|[A-Z][A-Z2]{2,4})$'
REGISTER='(R[0-9]|R1[0-5]|BP|SP|CR|SR|DR)'
HEX1='0[Xx][0-9A-F]{1,8}'
HEX2='[0-9A-F]{1,8}[Hh]'
OCT='0[0-7]+'
BIN='0[Bb][01]{1,32}'
DEC1='[+-]?([0-9]|[1-9][0-9]*)'
DEC2='#[+-]?([0-9]|[1-9][0-9]*)'
FLOAT='[+-]?([0-9]\.[0-9][0-9]*|[1-9][0-9]*\.[0-9][0-9]*)'
IMMEDIATE="(${BIN}|${OCT}|${DEC1}|${DEC2}|${FLOAT}|${HEX1}|${HEX2})"
INDEX="[-+]"
INDEXED="${REGISTER}[-+]${IMMEDIATE}"
DEREF='[[].*[]]'
IOPORTSYM='(TIM|RNG|GPU|SPU|INP|CAR|MEM)_[A-Z][A-Za-z]*'
IOPORTHEX='0[Xx][0-6][01][0-9A-F]'
GPUCMDSYM='GPU(Command|BlendingMode)_[A-Z][A-Za-z]*'
SNDCMDSYM='SPU(Command|ChannelState)_[A-Z][A-Za-z]*'
IOPORTCMDHEX='0[Xx][1-4][0-5]'
IOPORT="${IOPORTSYM}|${IOPORTHEX}"
LABEL='_[_A-Za-z0-9][_A-Za-z0-9]*'
OPERAND="(${DEREF}|${REGISTER}|${IMMEDIATE}|${IOPORT}|${LABEL})"

