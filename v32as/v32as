    ####################################################################################
    ##
    ## obtain input
    ##
    for line in $(cat ${file} | tr ' ' '@'); do

        ################################################################################
        ##
        ## reset variables
        ##
        the_opcode=
        imm_flag=0
        dst_operand=
        DSTREG=
        DSTVAL=
        DSTIMM=
        DSTFLG=0
        src_operand=
        SRCREG=
        SRCVAL=
        SRCIMM=
        SRCFLG=0
        ADDR=
        PORT=
        instruction=
        IMMEDIATE=
        LABELFLAG="false"

        line_input=$(echo "${line}" | tr '@' ' ')
        line_input=$(echo  "${line_input}" | tr -s ' ')       # excessive spaces
        line_input=$(echo  "${line_input}" | sed 's/ ,/,/g')  # space before comma
        line_input=$(echo  "${line_input}" | sed 's/;.*$//g') # comments

        debug    "line_input:    ${line_input}"

        num_operands=0
        for token in `echo "${line_input}" | tr -d ','`; do

            if [ "${num_operands}" -eq 0 ]; then
                label_check=$(echo "${token}" | egrep -io "^${LABEL}:$")
                if [ -z "${label_check}" ]; then
                    the_opcode=$(echo  "${token}" | egrep -io "${OPCODE}")
                    the_opcode="${the_opcode^^}"
                    if [ -z "${opcode[${the_opcode}]}" ]; then
                        do_error ${offset} \
                                 "${the_opcode} ${dst_operand} ${src_operand}" \
                                 "invalid instruction"
                    fi
                else
                    debug    "LABEL definition \"${token}\" at ${offset}"
                    lchk=$(cat ${LABELSYM} | egrep -o "^${token}"  | wc -l)
                    [ "${lchk}" -eq 0 ] && echo "${token}${offset}"    >> ${LABELSYM}
                    if [ "${lchk}" -gt 0 ]; then
                        do_error ${offset} " " "duplicate label ${token}"
                    fi
                    LABELFLAG="true"
                    break
                fi
            elif [ "${num_operands}" -eq 1 ]; then
                dst_operand=$(echo "${token}" | egrep -io "${OPERAND}")
            else
                src_operand=$(echo "${token}" | egrep -io "${OPERAND}")
            fi

            let num_operands=num_operands+1
        done
        let num_operands=num_operands-1

        ############################################################################
        ##
        ## if we are dealing with a label definition, avoid further instruction
        ## processing
        ##
        if [ "${LABELFLAG}" = "true" ]; then
            continue
        fi
 
        case "${the_opcode}" in
            "IN")
                dst_types="register"
                dst_flags=
                src_types="ioport"
                src_flags=
                ;;

            "OUT")
                dst_types="ioport"
                dst_flags=
                src_types="immediate register"
                src_flags=
                ;;

            "JMP"|"CALL")
                dst_types="immediate register"
                dst_flags="label"
                src_types=
                src_flags=
                ;;

            "JT"|"JF")
                dst_types="immediate register"
                dst_flags="label"
                src_types="register"
                src_flags=
                ;;

            "PUSH"|"POP"|"CMPS"|"CIF"|"CFI"|"CIB"|"CFB"|"NOT"|"BNOT"|"ISGN"|"IABS")
                dst_types="register"
                dst_flags=
                src_types=
                src_flags=
                ;;
            
            "FSGN"|"FABS"|"FLR"|"CEIL"|"ROUND"|"SIN"|"ACOS"|"LOG")
                dst_types="register"
                dst_flags=
                src_types=
                src_flags=
                ;;

            "HLT"|"WAIT"|"RET"|"MOVS"|"SETS")
                dst_types=
                dst_flags=
                src_types=
                src_flags=
                ;;

            "LEA")
                dst_types="register"
                dst_flags=
                src_types="register indexed"
                src_flags="deref"
                ;;
            
            "MOV")
                dst_types="immediate register indexed"
                dst_flags="deref"
                src_types="immediate register indexed"
                src_flags="deref"
                ;;
            
            *)
                dst_types="register"
                dst_flags=
                src_types="immediate register"
                src_flags=
                ;;
        esac

        ############################################################################
        ##
        ## If available, process the destination operand
        ##
        if [ ! -z "${dst_types}" ]; then
            result=$(parse_param ${dst_operand} "${dst_types}" "${dst_flags}")
            if [ "${result}" = "::::0::" ]; then
                do_error ${offset} "${the_opcode} ${dst_operand} ${src_operand}" syntax
            fi
            DSTREG=$(echo "${result}" | cut -d':' -f1)
            DSTVAL=$(echo "${result}" | cut -d':' -f2)
            DSTIMM=$(echo "${result}" | cut -d':' -f3)
            DSTREF=$(echo "${result}" | cut -d':' -f4)
            DSTFLG=$(echo "${result}" | cut -d':' -f5)
            DSTPRT=$(echo "${result}" | cut -d':' -f6)
            DSTLBL=$(echo "${result}" | cut -d':' -f7)
        fi

        ################################################################################
        ##
        ## If available, process the source operand
        ##
        if [ ! -z "${src_types}" ]; then
            result=$(parse_param ${src_operand} "${src_types}" "${src_flags}")
            if [ "${result}" = "::::0:" ]; then
                do_error ${offset} "${the_opcode} ${dst_operand} ${src_operand}" syntax
            fi
            SRCREG=$(echo "${result}" | cut -d':' -f1)
            SRCVAL=$(echo "${result}" | cut -d':' -f2)
            SRCIMM=$(echo "${result}" | cut -d':' -f3)
            SRCREF=$(echo "${result}" | cut -d':' -f4)
            SRCFLG=$(echo "${result}" | cut -d':' -f5)
            SRCPRT=$(echo "${result}" | cut -d':' -f6)
            SRCLBL=$(echo "${result}" | cut -d':' -f7)
        fi

        ################################################################################
        ##
        ## Error check: at most, only one immediate flag can be set across both the
        ## parameters
        ##
        if [ "${DSTFLG}" -eq 1 ] && \
           [ "${SRCFLG}" -eq 1 ]; then
            do_error ${offset} "${the_opcode} ${dst_operand} ${src_operand}" syntax
            #echo "ERROR: illegal multiple immediate operands"
        fi

        ################################################################################
        ##
        ## Set imm_flag if set on either parameter
        ##
        [ ! -z "${DSTFLG}" ] && [ "${DSTFLG}" -eq 1 ] && imm_flag="${DSTFLG}"
        [ ! -z "${SRCFLG}" ] && [ "${SRCFLG}" -eq 1 ] && imm_flag="${SRCFLG}"

        ################################################################################
        ##
        ## If MOV, determine addressing mode (ADDR)
        ##
        if [ "${the_opcode}" = "MOV" ]; then
            for ((index=0; index<8; index++)); do
                case ${index} in
                    0) # REG, IMM
                        [ ! -z "${DSTREG}" ] && [   -z "${SRCREG}" ] && \
                        [   -z "${DSTIMM}" ] && [ ! -z "${SRCIMM}" ] && \
                        [   -z "${DSTREF}" ] && [   -z "${SRCREF}" ] && ADDR="${index}"
                        ;;

                    1) # REG, REG
                        [ ! -z "${DSTREG}" ] && [ ! -z "${SRCREG}" ] && \
                        [   -z "${DSTIMM}" ] && [   -z "${SRCIMM}" ] && \
                        [   -z "${DSTREF}" ] && [   -z "${SRCREF}" ] && ADDR="${index}"
                        ;;

                    2) # REG, [IMM]
                        [ ! -z "${DSTREG}" ] && [   -z "${SRCREG}" ] && \
                        [   -z "${DSTIMM}" ] && [ ! -z "${SRCIMM}" ] && \
                        [   -z "${DSTREF}" ] && [ ! -z "${SRCREF}" ] && ADDR="${index}"
                        ;;

                    3) # REG, [REG]
                        [ ! -z "${DSTREG}" ] && [ ! -z "${SRCREG}" ] && \
                        [   -z "${DSTIMM}" ] && [   -z "${SRCIMM}" ] && \
                        [   -z "${DSTREF}" ] && [ ! -z "${SRCREF}" ] && ADDR="${index}"
                        ;;

                    4) # REG, [REG+IMM]
                        [ ! -z "${DSTREG}" ] && [ ! -z "${SRCREG}" ] && \
                        [   -z "${DSTIMM}" ] && [ ! -z "${SRCIMM}" ] && \
                        [   -z "${DSTREF}" ] && [ ! -z "${SRCREF}" ] && ADDR="${index}"
                        ;;

                    5) # [IMM], REG
                        [   -z "${DSTREG}" ] && [ ! -z "${SRCREG}" ] && \
                        [ ! -z "${DSTIMM}" ] && [   -z "${SRCIMM}" ] && \
                        [ ! -z "${DSTREF}" ] && [   -z "${SRCREF}" ] && ADDR="${index}"
                        ;;

                    6) # [REG], REG
                        [ ! -z "${DSTREG}" ] && [ ! -z "${SRCREG}" ] && \
                        [   -z "${DSTIMM}" ] && [   -z "${SRCIMM}" ] && \
                        [ ! -z "${DSTREF}" ] && [   -z "${SRCREF}" ] && ADDR="${index}"
                        ;;

                    7) # [REG+IMM], REG
                        [ ! -z "${DSTREG}" ] && [ ! -z "${SRCREG}" ] && \
                        [ ! -z "${DSTIMM}" ] && [   -z "${SRCIMM}" ] && \
                        [ ! -z "${DSTREF}" ] && [   -z "${SRCREF}" ] && ADDR="${index}"
                        ;;
                esac
            done

            ADDR=$(echo "obase=2; ${ADDR}" | bc -q)
            ADDR=$(printf "%.3d" "${ADDR}")
        else
            ADDR="000"
        fi

        ################################################################################
        ##
        ## Set PORT if set on either parameter
        ##
        [ ! -z "${DSTPRT}" ] && DSTPRT=$(echo "${DSTPRT}" | tr -d 'x')
        [ ! -z "${DSTPRT}" ] && PORT=$(echo "obase=2; ibase=16; ${DSTPRT}" | bc)
        [ ! -z "${SRCPRT}" ] && DSTPRT=$(echo "${SRCPRT}" | tr -d 'x')
        [ ! -z "${SRCPRT}" ] && PORT=$(echo "obase=2; ibase=16; ${SRCPRT}" | bc)
        [   -z "${PORT}"   ] && PORT="0"

        PORT=$(printf "%.14d" "${PORT}")

        [ ! -z "${DSTREG}" ] || IMMEDIATE="${DSTIMM}"
        [   -z "${DSTREG}" ] && DSTVAL="0000"
        [ ! -z "${SRCREG}" ] || IMMEDIATE="${SRCIMM}"
        [   -z "${SRCREG}" ] && SRCVAL="0000"
        [ ! -z "${DSTIMM}" ] && IMMEDIATE="${DSTIMM}"
        [ ! -z "${SRCIMM}" ] && IMMEDIATE="${SRCIMM}"

#        [ ! -z "${DSTREG}" ] && debug "DSTREG:    ${DSTREG} (DSTVAL: ${DSTVAL})"
#        [ ! -z "${DSTIMM}" ] && debug "DSTIMM:    ${DSTIMM}"
#        [ ! -z "${DSTREF}" ] && debug "DSTREF:    ${DSTREF}"
#        [ ! -z "${SRCREG}" ] && debug "SRCREG:    ${SRCREG} (SRCVAL: ${SRCVAL})"
#        [ ! -z "${SRCIMM}" ] && debug "SRCIMM:    ${SRCIMM}"
#        [ ! -z "${SRCREF}" ] && debug "SRCREF:    ${SRCREF}"

        ################################################################################
        ##
        ## form the current instruction binary, convert to hexadecimal
        ##
        binary="${opcode[${the_opcode}]}${imm_flag}${DSTVAL}${SRCVAL}${ADDR}${PORT}"
        instruction=$(echo   "obase=10; ibase=2; ${binary}" | bc -q)
        instruction=$(printf "0x%.8X" "${instruction}")

        ############################################################################
        ##
        ## report on the instruction being processed
        ##
        if [ ! -z "${the_opcode}" ]; then
            debug    "======================================================"
            if [ ! -z "${offset}" ]; then
                debug    "offset:        ${offset}"
                debug    "------------------------------------------------------"
            fi
            debug    "the_opcode:    \"${the_opcode}\" (0b${opcode[${the_opcode}]})"
            debug    "------------------------------------------------------"
            debug    "imm_flag:      ${imm_flag}"
            debug    "------------------------------------------------------"
            if [ ! -z "${dst_operand}" ]; then
                debug    "dst_operand:   ${dst_operand}"
                debug    "dst_types:     ${dst_types}"
                debug    "dst_flags:     ${dst_flags}"
            else
                debug    "no dst:        0b0000"
            fi
            debug    "------------------------------------------------------"
            if [ ! -z "${src_operand}" ]; then
                debug    "src_operand:   ${src_operand}"
                debug    "src_types:     ${src_types}"
                debug    "src_flags:     ${src_flags}"
            else
                debug    "no src:        0b0000"
            fi
            debug    "------------------------------------------------------"
            debug    "ADDR:          0b${ADDR}"
            debug    "------------------------------------------------------"
            debug    "PORT:          0b${PORT}"
            debug    "======================================================"
            debug -n "instruction:   ${opcode[${the_opcode}]} ${imm_flag} ${DSTVAL} "
            debug -H "${SRCVAL} ${ADDR} ${PORT}"
            hexalign="${opcode[${the_opcode}]}${imm_flag}${DSTVAL}"
            hexalign="${hexalign}${SRCVAL}${ADDR}${PORT}"
            debug -n "instruction:   "
            for ((index=1; index<=32; index+=4)); do
                let indexend=index+3
                if [ "${index}" -lt 28 ]; then
                    debug -n -H "$(echo ${hexalign} | cut -c${index}-${indexend}) "
                else
                    debug    -H "$(echo ${hexalign} | cut -c${index}-${indexend}) "
                fi
            done
            debug    "------------------------------------------------------"
            debug    "INSTRUCTION:   ${instruction}"
            if [ ! -z "${IMMEDIATE}" ]; then
                debug    "------------------------------------------------------"
                debug    "IMMEDIATE:     ${IMMEDIATE}"
            fi
            debug    "======================================================"
        fi

        ################################################################################
        ##
        ## if not in binary mode, output the hex of the instruction and
        ## any immediate data to STDOUT
        ##
        if [ "${BINARY}" = "false" ] && [ "${VERBOSE}" = "false" ]; then
            [ ! -z "${offset}"      ] && echo    "offset:      ${offset}"
            [ ! -z "${instruction}" ] && echo    "instruction: ${instruction}"
            [ ! -z "${IMMEDIATE}"   ] && echo    "immediate:   ${IMMEDIATE}"
            echo "-----------------------"
        else
            echo "${instruction}"                                       >> ${TMP}
            [ ! -z "${IMMEDIATE}" ] && echo "${IMMEDIATE}"              >> ${TMP}
        fi

        ################################################################################
        ##
        ## if single step is enabled: pause for confirmation
        ##
        [ "${DO_STEP}" = "true" ] && read -e confirmation
        [ "${VERBOSE}" = "true" ] && clear

        ################################################################################
        ##
        ## adjust offset (if offsets are being kept)
        ##
        if [ ! -z "${offset}" ]; then
            offset=$(echo "obase=16; ibase=16; ${offset}+1" | tr -d 'x' | bc)
            if [ ! -z "${IMMEDIATE}" ]; then
                offset=$(echo "obase=16; ibase=16; ${offset}+1" | tr -d 'x' | bc)
            fi
            offset=$(printf "0x%.8X" "0x${offset}")
        fi
    done
done

########################################################################################
##
## remove all generated temporary files
##
rm -f ${TMP} ${LABELSYM} ${BINFILE}

exit 0
