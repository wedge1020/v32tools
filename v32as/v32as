        dst_operand_flags="deref"
        src_operand_types="immediate register indexed"
        src_operand_flags="deref"
        ;;
    
    *)
        dst_operand_types="register"
        dst_operand_flags=
        src_operand_types="immediate register"
        src_operand_flags=
        ;;
esac

DSTFLG=0
SRCFLG=0

echo "======================================="
echo "the_opcode:        ${the_opcode}"
echo "dst_operand:       ${dst_operand}"
echo "dst_operand_types: ${dst_operand_types}"
echo "dst_operand_flags: ${dst_operand_flags}"
echo "======================================="

########################################################################################
##
## If available, process the destination operand
##
if [ ! -z "${dst_operand_types}" ]; then
    result=$(parse_param ${dst_operand} "${dst_operand_types}" "${dst_operand_flags}")
    DSTREG=$(echo "${result}" | cut -d':' -f1)
    DSTVAL=$(echo "${result}" | cut -d':' -f2)
    DSTIMM=$(echo "${result}" | cut -d':' -f3)
    DSTREF=$(echo "${result}" | cut -d':' -f4)
    DSTFLG=$(echo "${result}" | cut -d':' -f5)
    DSTPRT=$(echo "${result}" | cut -d':' -f6)
fi

########################################################################################
##
## If available, process the source operand
##
if [ ! -z "${src_operand_types}" ]; then
    result=$(parse_param ${src_operand} "${src_operand_types}" "${src_operand_flags}")
    SRCREG=$(echo "${result}" | cut -d':' -f1)
    SRCVAL=$(echo "${result}" | cut -d':' -f2)
    SRCIMM=$(echo "${result}" | cut -d':' -f3)
    SRCREF=$(echo "${result}" | cut -d':' -f4)
    SRCFLG=$(echo "${result}" | cut -d':' -f5)
    SRCPRT=$(echo "${result}" | cut -d':' -f6)
fi

########################################################################################
##
## Error check: at most, only one immediate flag can be set across both the
## parameters
##
if [ "${DSTFLG}" -eq 1 ] && \
   [ "${SRCFLG}" -eq 1 ]; then
    echo "ERROR: illegal multiple immediate operands"
    exit 7
fi

echo "the_opcode:      ${the_opcode}"
echo "num_operands:    ${num_operands}"
[ ! -z "${dst_operand}" ] && echo "first_operand:   ${dst_operand}"
[ ! -z "${src_operand}" ] && echo "second_operand:  ${src_operand}"

########################################################################################
##
## Set imm_flag if set on either parameter
##
[ ! -z "${DSTFLG}" ] && [ "${DSTFLG}" -eq 1 ] && imm_flag="${DSTFLG}"
[ ! -z "${SRCFLG}" ] && [ "${SRCFLG}" -eq 1 ] && imm_flag="${SRCFLG}"

########################################################################################
##
## If MOV, determine addressing mode (ADDRMODE)
##
if [ "${the_opcode}" = "MOV" ]; then
    for ((index=0; index<8; index++)); do
        case ${index} in
            0) # REG, IMM
                [ ! -z "${DSTREG}" ] && [   -z "${SRCREG}" ] && \
                [   -z "${DSTIMM}" ] && [ ! -z "${SRCIMM}" ] && \
                [   -z "${DSTREF}" ] && [   -z "${SRCREF}" ] && ADDMODE="${index}"
                ;;

            1) # REG, REG
                [ ! -z "${DSTREG}" ] && [ ! -z "${SRCREG}" ] && \
                [   -z "${DSTIMM}" ] && [   -z "${SRCIMM}" ] && \
                [   -z "${DSTREF}" ] && [   -z "${SRCREF}" ] && ADDMODE="${index}"
                ;;

            2) # REG, [IMM]
                [ ! -z "${DSTREG}" ] && [   -z "${SRCREG}" ] && \
                [   -z "${DSTIMM}" ] && [ ! -z "${SRCIMM}" ] && \
                [   -z "${DSTREF}" ] && [ ! -z "${SRCREF}" ] && ADDMODE="${index}"
                ;;

            3) # REG, [REG]
                [ ! -z "${DSTREG}" ] && [ ! -z "${SRCREG}" ] && \
                [   -z "${DSTIMM}" ] && [   -z "${SRCIMM}" ] && \
                [   -z "${DSTREF}" ] && [ ! -z "${SRCREF}" ] && ADDMODE="${index}"
                ;;

            4) # REG, [REG+IMM]
                [ ! -z "${DSTREG}" ] && [ ! -z "${SRCREG}" ] && \
                [   -z "${DSTIMM}" ] && [ ! -z "${SRCIMM}" ] && \
                [   -z "${DSTREF}" ] && [ ! -z "${SRCREF}" ] && ADDMODE="${index}"
                ;;

            5) # [IMM], REG
                [   -z "${DSTREG}" ] && [ ! -z "${SRCREG}" ] && \
                [ ! -z "${DSTIMM}" ] && [   -z "${SRCIMM}" ] && \
                [ ! -z "${DSTREF}" ] && [   -z "${SRCREF}" ] && ADDMODE="${index}"
                ;;

            6) # [REG], REG
                [ ! -z "${DSTREG}" ] && [ ! -z "${SRCREG}" ] && \
                [   -z "${DSTIMM}" ] && [   -z "${SRCIMM}" ] && \
                [ ! -z "${DSTREF}" ] && [   -z "${SRCREF}" ] && ADDMODE="${index}"
                ;;

            7) # [REG+IMM], REG
                [ ! -z "${DSTREG}" ] && [ ! -z "${SRCREG}" ] && \
                [ ! -z "${DSTIMM}" ] && [   -z "${SRCIMM}" ] && \
                [ ! -z "${DSTREF}" ] && [   -z "${SRCREF}" ] && ADDRMODE="${index}"
                ;;
        esac
    done

    ADDRMODE=$(echo "obase=2; ${ADDMODE}" | bc -q)
    ADDRMODE=$(printf "%.3d" "${ADDRMODE}")
else
    ADDRMODE="000"
fi

########################################################################################
##
## Set PORT if set on either parameter
##
[ ! -z "${DSTPRT}" ] && PORT=$(echo "obase=2; ibase=16; ${DSTPRT}" | tr -d 'x' | bc)
[ ! -z "${SRCPRT}" ] && PORT=$(echo "obase=2; ibase=16; ${SRCPRT}" | tr -d 'x' | bc)
[   -z "${PORT}"   ] && PORT="0"

PORT=$(printf "%.14d" "${PORT}")

echo "--------"
echo "opcode:    \"${the_opcode}\" (${opcode[${the_opcode}]})"
echo "imm_flag:  ${imm_flag}"
IMMEDIATE=
[ ! -z "${DSTREG}" ] || IMMEDIATE="${DSTIMM}"
[   -z "${DSTREG}" ] && DSTVAL="0000"
[ ! -z "${SRCREG}" ] || IMMEDIATE="${SRCIMM}"
[   -z "${SRCREG}" ] && SRCVAL="0000"
[ ! -z "${DSTIMM}" ] && IMMEDIATE="${DSTIMM}"
[ ! -z "${SRCIMM}" ] && IMMEDIATE="${SRCIMM}"

[ ! -z "${DSTREG}" ] && echo "DSTREG:    ${DSTREG} (DSTVAL: ${DSTVAL})"
[ ! -z "${DSTIMM}" ] && echo "DSTIMM:    ${DSTIMM}"
[ ! -z "${DSTREF}" ] && echo "DSTREF:    ${DSTREF}"
[ ! -z "${SRCREG}" ] && echo "SRCREG:    ${SRCREG} (SRCVAL: ${SRCVAL})"
[ ! -z "${SRCIMM}" ] && echo "SRCIMM:    ${SRCIMM}"
[ ! -z "${SRCREF}" ] && echo "SRCREF:    ${SRCREF}"
echo "ADDRMODE:  0b${ADDRMODE}"
echo "PORT:      0b${PORT}"
echo "--------"
echo "instruction: ${opcode[${the_opcode}]} ${imm_flag} ${DSTVAL} ${SRCVAL} ${ADDRMODE} ${PORT}"
binary="${opcode[${the_opcode}]}${imm_flag}${DSTVAL}${SRCVAL}${ADDRMODE}${PORT}"
instruction=$(echo   "obase=10; ibase=2; ${binary}" | bc -q)
instruction=$(printf "0x%.8X" "${instruction}")
echo "instruction: ${instruction}"
if [ ! -z "${IMMEDIATE}" ]; then
    echo "immediate:   ${IMMEDIATE}"
fi

echo "done"

exit 0
